# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
.pytest_cache/

# Generated models — rebuild with: python -m scripts.run_pipeline
# The evidence reports stay committed: they back every number in the README.
models/*
!models/reports/
# The validated encoder travels with the repo (8.6 MB) so anyone with a
# Snapdragon laptop can verify the exact model the results were measured on.
!models/whisper-tiny-qdq/
*.onnx
*.onnx.data
!models/whisper-tiny-qdq/*.onnx
!models/whisper-tiny-qdq/*.onnx.data
*.ort
*.qnn

# Downloaded speech — re-fetch with: python -m scripts.fetch_speech
data/

# Build / misc
dist/
build/
*.log
# ...except the device logs, which are evidence
!models/reports/device_logs/*.log
*.prof
*.json.bak
.env
node_modules/

# Local editor/agent tooling
.claude/
